{
  "version": "2.0.0",
  "inputs": [
    {
      "id": "gitRef",
      "type": "promptString",
      "description": "Git ref (branch, tag, or commit SHA) to deploy. ibmi-deploy.sh has pub400 pull this ref from GitHub itself, so it must already be pushed — an unpushed local branch or commit will not deploy. Defaults to 'main'.",
      "default": "main"
    }
  ],
  "tasks": [
    {
      "label": "IBM i: Deploy Source",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/ibmi-deploy.sh",
      "args": ["${input:gitRef}"],
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    },
    {
      "label": "IBM i: Compile All",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/ibmi-compile.sh",
      "args": [],
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    },
    {
      "label": "IBM i: Deploy + Compile",
      "dependsOrder": "sequence",
      "dependsOn": ["IBM i: Deploy Source", "IBM i: Compile All"],
      "problemMatcher": []
    }
  ]
}
