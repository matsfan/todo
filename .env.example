# This file documents the variables needed to run deploy/compile scripts locally.
# CI uses repository secrets (IBMI_USER, IBMI_SSH_KEY) — this file is only needed
# if you want to run scripts/ibmi-deploy.sh or scripts/ibmi-compile.sh by hand.

IBMI_USER=your-pub400-username
IBMI_IDENTITY=~/.ssh/ci-key
IBMI_CURLIB=YOURCURLIB
# IFS directory under /home/<user>/source/ where the repo is checked out on pub400.
# deploy-dev.yml uses todo-dev (→ MBPRICE1); deploy-test.yml uses todo-test (→ MBPRICE2).
IBMI_IFS_DIR=todo-dev
